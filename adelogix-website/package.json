{
  "name": "adelogix-website",
  "version": "1.0.0",
  "private": true,
  "description": "Adelogix Software Technology company website. Static, dependency-free build.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:review": "node scripts/build.mjs --review",
